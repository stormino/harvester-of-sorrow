{
  "name": "hos-ui",
  "private": true,
  "version": "7.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "fetch:api": "curl -sf http://localhost:8080/v3/api-docs -o openapi.json && npm run gen:api"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.12"
  }
}
